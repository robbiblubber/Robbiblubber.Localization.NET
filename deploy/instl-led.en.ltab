cid = lang.def;
version = 3.0;

data
{
    addlang = Additional Language Support;
    addlang.descr = This package contains additional language support packs.\nSelect this to install all language definitions available.;
    descr = The robbiblubber.org Localization Editor.;
    desktop = Desktop Icon;
    desktop.descr = This package will create an icon for the robbiblubber.org Localization Editor on your desktop.;
    install = Installation;
    install.descr = The installer is ready to install the robbiblubber.org Localization Editor.\nPlease click 'Install' to begin the installation process.;
    lic = License Agreement;
    lic.descr = Please take a moment to read the license agreement.\nThe robbiblubber.org Localization Editor is provided under the MIT license. By continuing the installation the application you accept the terms of this license agreement.;
    link.descr = The robbiblubber.org Localization Editor.;
    link.desktop = $CommonDesktop\\Localization Editor.lnk;
    link.programs = $CommonPrograms\\Localization Editor.lnk;
    main = Localization Editor;
    main.descr = This package contains the required components for the robbiblubber.org Localization Editor.\nYou cannot exclude this package from the installation.;
    name = Localization Editor;
    pkgsel = Feature Selection;
    pkgsel.descr = This will install the robbiblubber.org Localization Editor on your computer.\n\nPlease select the features you want to install.;
    programs = Links in Programs;
    programs.descr = This package will create links in your Start Menu programs selection.;
}

header
{
    author = robbiblubber.org;
    key = instl-led;
    lang = en;
    name = Localization Editor Installation;
    prefixes = instl-led;
    version = 1.0;
}
